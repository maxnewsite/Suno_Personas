# API Keys (choose one or use hybrid)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Provider Configuration
# Options: "openai", "anthropic", "hybrid", "local"
LLM_PROVIDER=openai

# For hybrid or local mode
USE_LOCAL_LLM=false
LOCAL_LLM_URL=http://localhost:8001
ENABLE_HYBRID_MODE=false
CRITICAL_PERSONAS_CLOUD=true

# OpenAI Model
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Model
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Server Configuration
MAX_FILE_SIZE_MB=10
MAX_DURATION_SECONDS=600
UPLOAD_DIR=./temp_uploads

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_PER_HOUR=10

# Caching (recommended for cost reduction)
ENABLE_CACHING=false
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400

# Tiered Analysis
FREE_TIER_PERSONAS=3
PAID_TIER_PERSONAS=10
